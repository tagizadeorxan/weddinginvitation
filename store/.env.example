# Payoneer Checkout credentials (see store setup notes below)
#
# In Payoneer: Checkout → Integration → API access
#   - API Username  → PAYONEER_MERCHANT_CODE (same as "Store Code" in some plugins)
#   - API Token     → PAYONEER_PAYMENT_TOKEN  (click GENERATE TOKEN; copy once)
#
# You do NOT put longId here. longId is created per checkout by your server.
PAYONEER_MERCHANT_CODE=your_api_username
PAYONEER_PAYMENT_TOKEN=your_api_token

# "test" for sandbox, "live" for production
PAYONEER_ENV=test

# Product pricing
PRODUCT_PRICE=49
PRODUCT_CURRENCY=USD
PRODUCT_COUNTRY=US

# Your public site URL (used for Payoneer callback URLs)
SITE_URL=http://localhost:5173

# Server port
PORT=3001
